# Optional overrides. FastAPI loads ../.env first (repo root), then this file.
# Put shared secrets (DATABASE_URL, IGNIS_NIM_API_KEY) in the repo-root .env
# used by start.bat — not in the frontend.

# IGNIS_NIM_API_KEY=nvapi-…
# IGNIS_CHAT_BACKEND=ollama
# IGNIS_EMBED_BACKEND=ollama
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
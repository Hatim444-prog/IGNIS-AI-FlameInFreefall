# Shared secrets / infrastructure (commit only this file, not .env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional server-wide default for embeddings (768-d Nomic in DB)
# IGNIS_EMBED_BACKEND=ollama

# Per-user NVIDIA keys: use the /test/ UI (localStorage + request headers), NOT .env.
# Optional overrides for NIM model IDs (same for all users):
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NIM_VISION_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Local Docker Postgres alternative:
# POSTGRES_PASSWORD=CHANGE_ME

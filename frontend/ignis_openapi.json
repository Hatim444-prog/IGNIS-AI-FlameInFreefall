          "file_type",
          "source_url",
          "verification_status",
          "passages"
        ],
        "title": "IndexedDocument"
      },
      "MissionRequest": {
        "properties": {
          "environment": {
            "type": "string",
            "enum": [
              "pressurized_lunar_rover",
              "lunar_habitat",
              "mars_habitat",
              "spacecraft",
              "space_station"
            ],
            "title": "Environment",
            "default": "pressurized_lunar_rover"
          },
          "research_focus": {
            "type": "string",
            "enum": [
              "suppression",
              "prevention",
              "detection"
            ],
            "title": "Research Focus",
            "default": "suppression"
          },
          "oxygen_percent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Oxygen Percent",
            "default": 32.0
          },
          "pressure_psi": {
            "type": "number",
            "maximum": 30.0,
            "exclusiveMinimum": 0.0,
            "title": "Pressure Psi",
            "default": 12.2
          },
          "fuel_material": {
            "anyOf": [

# Optional direct API origin for local development. Keep blank on Vercel so
# browser requests use the same-origin proxy and its private service binding.
VITE_IGNIS_API_URL=

# IGNIS_API_ORIGIN is injected by the Vercel service binding; do not set it.
# Set IGNIS_NIM_API_KEY in the Vercel server environment if using NVIDIA NIM.

# Optional public API origin for direct browser requests and large uploads.
# Leave blank to use the same-origin /ai Vercel Function proxy.
VITE_IGNIS_API_URL=

# Server-only Vercel Function settings. Never prefix these with VITE_.
IGNIS_API_ORIGIN=https://api.example.com
# Set IGNIS_NIM_API_KEY as a server environment variable if using NVIDIA NIM.

                "type": "string",
                "maxLength": 150
              },
              {
                "type": "null"
              }
            ],
            "title": "Variable Name"
          },
          "experiment_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 25,
            "title": "Experiment Codes"
          },
          "max_experiments": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Experiments",
            "default": 8
          },
          "top_k_papers": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Top K Papers",
            "default": 4
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "HybridQuestion"
      },
